# ============================================================
# OntologyReady 2.0 - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ── Database ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ontology
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ontology
DATABASE_MAX_CONNECTIONS=20

# ── Backend ──────────────────────────────────────────────
BACKEND_PORT=8080
APP_NAME="OntologyReady 2.0"
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── File Storage ─────────────────────────────────────────
FILE_STORAGE_ROOT=/data/files

# ── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3000

# ── Redis (optional) ─────────────────────────────────────
REDIS_PORT=6379

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── LLM Provider Keys ────────────────────────────────────
# Uncomment and fill in keys for providers you use.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Provider Config Path ─────────────────────────────────
PROVIDER_CONFIG=config/providers.json
